#Discord Bot Configuration

# Discord Bot Token from Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Server Whitelist Safeguard (Optional):
# Restrict bot to a specific server ID (leave blank to allow any server)
GUILD_ID=your_server_id_here

# Designated voice channel ID to auto-join silently on startup (Optional):
# Leave blank to automatically find any voice channel named 'radio', 'music', 'hangout', or 'stream'
AUTO_JOIN_VOICE_CHANNEL_ID=your_voice_channel_id_here
